# test (./deploy/test): separate project, volumes and ports, so it can run next to dev.
# Throwaway data only; the password is a fixed non-secret because the DB is never published outside Docker.
COMPOSE_PROJECT_NAME=collections-app-test
APP_ENV=development
API_PORT=8090
WEB_PORT=5183
POSTGRES_PASSWORD=test-only-not-a-secret
WORKSPACE_NAME="Test Collection"
LOG_LEVEL=debug
LOG_FORMAT=text
