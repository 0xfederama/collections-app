# dev (./deploy/dev): automated checks and agents; separate project, volumes and ports, so it runs next to test.
# Throwaway data only; the password is a fixed non-secret because the DB is never published outside Docker.
COMPOSE_PROJECT_NAME=collections-app-dev
APP_ENV=development
TMDB_MOCK_FIXTURE=true
API_PORT=8090
WEB_PORT=5183
POSTGRES_PASSWORD=test-only-not-a-secret
WORKSPACE_NAME="Dev Collection"
LOG_LEVEL=debug
LOG_FORMAT=text
