#!/usr/bin/env bash
# test: your manual testing environment. Data persists; agents never use or wipe it. Vite dev server (hot reload).
#
#   ./deploy/test up -d            build and start in the background (omit -d to follow the logs)
#   ./deploy/test down             stop; the data is kept
#   ./deploy/test <compose cmd>    anything docker compose does: ps, logs -f api, restart web, ...
#
# web http://localhost:5173   api http://localhost:8080   settings: deploy/local/test.env
set -euo pipefail
ENV_NAME="test"
# shellcheck source=deploy/lib.sh
. "$(dirname "$0")/lib.sh"

use_local_stack
run_local "$@"
