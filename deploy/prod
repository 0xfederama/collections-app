#!/usr/bin/env bash
# prod: the real app on the Raspberry Pi. Images are pulled from GHCR (D-117); only web publishes a port.
#
#   ./deploy/prod check                   exposure check: run it first and after every deploy/server/.env edit
#   ./deploy/prod up -d                   start the released versions (any docker compose command works: ps, logs -f api, down)
#   ./deploy/prod release                 deploy the latest published releases now (the timer runs this every minute)
#   ./deploy/prod backup [dest]           Postgres + images (default $BACKUP_DIR, /srv/collection/backups)
#   ./deploy/prod restore <dir> [--force] restore a backup (asks before replacing data)
#   ./deploy/prod verify <dir>            compare a backup with the running database
#   ./deploy/prod prune [dest]            keep the newest backup of each of the last 7 days and 4 weeks
#   ./deploy/prod backup-status [hours]   fail if the newest backup is missing, incomplete or older than [hours] (26)
#
# web http://127.0.0.1:8081 (or WEB_BIND)   settings + secrets: deploy/server/.env   guide: deploy/README.md
set -euo pipefail
ENV_NAME="prod"
# shellcheck source=deploy/lib.sh
. "$(dirname "$0")/lib.sh"
case "${1:-}" in
  "") usage 1 ;;
  -h | --help | help) usage ;;
esac
here="$DEPLOY/server"
root="$ROOT"
need_file "$here/.env" "cp deploy/server/.env.example deploy/server/.env and set POSTGRES_PASSWORD"

# Compose reads deploy/server/.env itself; the backend scripts also need the values in the environment
# (they would otherwise pick up backend/.env, which is the dev password).
set -a
# shellcheck disable=SC1091
. "$here/.env"
set +a
# Deployed versions (written by release.sh); values already in the environment win.
if [ -f "$here/versions.env" ]; then
  while IFS== read -r k v; do
    [ -n "$k" ] && [ -z "${!k:-}" ] && export "$k=$v"
  done <"$here/versions.env"
fi
# PROD_PROJECT is only for trial runs next to a real prod stack (own containers and volumes); leave it unset on the server.
export COMPOSE_FILE="$here/compose.yaml" COMPOSE_PROJECT_NAME="${PROD_PROJECT:-collections-app-prod}"
backups="${BACKUP_DIR:-/srv/collection/backups}"


# Newest backup per day (first 7 days) and per ISO week (first 4 weeks); everything else goes.
prune() {
  local dest="${1:-$backups}" dir name day week kept=0 removed=0
  local -a seen_days=() seen_weeks=()
  [ -d "$dest" ] || die "no such directory: $dest"
  while IFS= read -r name; do
    [[ "$name" =~ ^[0-9]{8}T[0-9]{6}Z$ ]] || continue
    day="${name:0:8}"
    if date -u -d "$day" +%G-%V >/dev/null 2>&1; then
      week="$(date -u -d "$day" +%G-%V)"
    else
      week="$(date -u -j -f %Y%m%d "$day" +%G-%V)"
    fi
    keep=0
    if [[ ! " ${seen_days[*]-} " == *" $day "* ]] && [ "${#seen_days[@]}" -lt 7 ]; then
      seen_days+=("$day"); keep=1
    fi
    if [[ ! " ${seen_weeks[*]-} " == *" $week "* ]] && [ "${#seen_weeks[@]}" -lt 4 ]; then
      seen_weeks+=("$week"); keep=1
    fi
    if [ "$keep" = 1 ]; then
      kept=$((kept + 1))
    else
      dir="$dest/$name"
      rm -rf -- "$dir"
      removed=$((removed + 1))
      echo "removed $dir"
    fi
  done < <(cd "$dest" && printf '%s\n' * | sort -r)
  ok "prune: kept $kept, removed $removed"
}

# Did the scheduled backup run? Newest backup must exist, have its manifest, and be younger than max hours.
backup_status() {
  local max="${1:-26}" newest stamp epoch now age
  [[ "$max" =~ ^[0-9]+$ ]] || die "hours must be a whole number: $max"
  [ -d "$backups" ] || die "no backups directory: $backups"
  newest="$(cd "$backups" && printf '%s\n' * | grep -E '^[0-9]{8}T[0-9]{6}Z$' | sort -r | head -n1 || true)"
  [ -n "$newest" ] || die "no backups in $backups"
  [ -f "$backups/$newest/manifest.json" ] || die "newest backup $newest has no manifest.json (incomplete)"
  stamp="${newest:0:4}-${newest:4:2}-${newest:6:2}T${newest:9:2}:${newest:11:2}:${newest:13:2}Z"
  if epoch="$(date -u -d "$stamp" +%s 2>/dev/null)"; then :; else
    epoch="$(date -u -j -f %Y%m%dT%H%M%SZ "$newest" +%s)"
  fi
  now="$(date -u +%s)"
  age=$(( (now - epoch) / 3600 ))
  [ "$age" -le "$max" ] || die "newest backup $newest is ${age}h old (limit ${max}h): check the timer (systemctl status collection-backup.timer)"
  ok "backup-status: newest $newest, ${age}h old"
}

cmd="${1:-}"
[ -n "$cmd" ] || usage 1
shift
case "$cmd" in
  -h | --help | help) usage ;;
  backup)
    dest="${1:-$backups}"
    mkdir -p "$dest"
    exec "$here/backup/backup.sh" "$dest"
    ;;
  restore) exec "$here/backup/restore.sh" "$@" ;;
  verify) exec "$here/backup/verify-restore.sh" "$@" ;;
  prune) prune "$@" ;;
  backup-status) backup_status "$@" ;;
  check) exec "$here/check.sh" ;;
  release) exec "$here/release.sh" ;;
  *) exec docker compose "$cmd" "$@" ;;
esac
