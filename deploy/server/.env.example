# Copy to deploy/server/.env (gitignored). Placeholders only; never commit real secrets.
# URL-safe characters only in the password (it is embedded in DATABASE_URL). Example: openssl rand -hex 24
POSTGRES_PASSWORD=

# Port the web container publishes on the host.
WEB_PORT=8081
# Address it binds to. Leave as is (loopback). To reach the app from your tailnet or LAN, set the host's
# Tailscale/LAN IP here, never 0.0.0.0 and never a public address (no auth before Phase 3).
WEB_BIND=127.0.0.1

WORKSPACE_NAME="Our Collection"
LOG_LEVEL=info

# Where `deploy/prod backup` writes (outside the repo; backups hold all your data).
BACKUP_DIR=/srv/collection/backups

# TMDB API key (server side only; movie and TV lookup, F-013). Get one at https://www.themoviedb.org/settings/api. Empty disables the lookup.
TMDB_API_KEY=

# Optional Hardcover token (server side only): fills the author and page count Open Library lacks, and books it does not know, in the automatic book lookup. Empty disables it. The token expires, so renew it when lookups stop filling gaps.
HARDCOVER_API_KEY=

# Read-only GitHub token (D-117): release checks every minute and GHCR image pulls. Classic: read:packages; fine-grained: Contents read on both repos.
GITHUB_TOKEN=

# Off-Pi backups (roadmap #21): rclone remote holding the encrypted copies, and how many to keep on Drive.
OFFSITE_REMOTE=gdrive-crypt:collections-backups
OFFSITE_KEEP=30
