# Copy to deploy/server/.env (gitignored). Placeholders only; never commit real secrets.
# URL-safe characters only in the password (it is embedded in DATABASE_URL). Example: openssl rand -hex 24
POSTGRES_PASSWORD=

# Port the web container publishes on the host (the Pi uses 80; the test stack uses TEST_WEB_PORT).
WEB_PORT=80
# Address it binds to. Leave as is (loopback). To reach the app from your tailnet or LAN, set the host's
# Tailscale/LAN IP here, never 0.0.0.0 and never a public address (no auth before Phase 3).
WEB_BIND=127.0.0.1

LOG_LEVEL=info

# Accounts (roadmap #31, F-027, backend 3.0.0+): the app trusts only the signed Cloudflare Access token.
# ACCESS_TEAM_DOMAIN: Zero Trust → Settings → Team name and domain (<team>.cloudflareaccess.com).
# ACCESS_AUD: Access → Applications → the Collections app → Overview → Application Audience (AUD) Tag.
ACCESS_TEAM_DOMAIN=
ACCESS_AUD=
# Your Google email: owns everything created before accounts existed, and is who every request from the home network
# (raspberrypi.local, the LAN IP) acts as, always (D-150). Anyone on the home Wi-Fi is this user.
OWNER_EMAIL=

# Where `deploy/prod backup` writes (outside the repo; backups hold all your data).
BACKUP_DIR=/srv/collection/backups

# TMDB API key (server side only; movie and TV lookup, F-013). Get one at https://www.themoviedb.org/settings/api. Empty disables the lookup.
TMDB_API_KEY=

# Optional Hardcover token (server side only): fills the author and page count Open Library lacks, and books it does not know, in the automatic book lookup. Empty disables it. The token expires, so renew it when lookups stop filling gaps.
HARDCOVER_API_KEY=

# Read-only GitHub token (D-117): release checks every minute and GHCR image pulls. Classic: read:packages; fine-grained: Contents read on both repos.
GITHUB_TOKEN=

# Off-Pi backups (roadmap #21): rclone remote holding the encrypted copies, and how many to keep on Drive.
OFFSITE_REMOTE=gdrive-crypt:collections-backups
OFFSITE_KEEP=30

# Test stack on the Pi (roadmap #22, ./deploy/pitest): always on. Every release check keeps it running and deploys the
# newest release of each repo, pre-releases included, to it, on TEST_WEB_PORT (LAN only). Allow the port in ufw.
TEST_WEB_PORT=8081

# Alerts (roadmap #24): healthchecks.io project ping key (Project → Settings → Ping key). Empty disables alerts.
# Checks are created on first ping: collections-release, collections-deploy, collections-backup, raspberrypi.
HC_PING_KEY=
# Health ping thresholds (deploy/server/health.sh).
HEALTH_DISK_MAX=85
HEALTH_MEM_MIN_MB=100

# Hosted logs and latency charts (roadmap #25): Grafana Cloud Loki. Set COMPOSE_PROFILES=logs to start the shipper.
# Grafana Cloud → your stack → Loki → Details: host (logs-prod-XXX.grafana.net), user (number), and a token with logs:write.
COMPOSE_PROFILES=
# Remote access (roadmap #30): add "tunnel" to COMPOSE_PROFILES (e.g. COMPOSE_PROFILES=logs,tunnel) and paste the token of the
# Cloudflare Zero Trust tunnel (Networks → Tunnels → your tunnel → Docker install command, the part after --token).
TUNNEL_TOKEN=
LOKI_HOST=
LOKI_USER=
LOKI_TOKEN=
