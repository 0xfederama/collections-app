{
  "title": "Collections on the Pi",
  "uid": "collections-pi",
  "schemaVersion": 39,
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "DS",
        "type": "datasource",
        "query": "loki",
        "label": "Logs"
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "API latency p95 by route",
      "datasource": {
        "type": "loki",
        "uid": "${DS}"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "quantile_over_time(0.95, {container=\"collections-app-prod-api-1\"} | json | msg=\"request\" | unwrap duration_ms [$__auto]) by (route)",
          "legendFormat": "{{route}}",
          "queryType": "range"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "API latency p50 by route",
      "datasource": {
        "type": "loki",
        "uid": "${DS}"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "quantile_over_time(0.5, {container=\"collections-app-prod-api-1\"} | json | msg=\"request\" | unwrap duration_ms [$__auto]) by (route)",
          "legendFormat": "{{route}}",
          "queryType": "range"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Requests by status",
      "datasource": {
        "type": "loki",
        "uid": "${DS}"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (status) (count_over_time({container=\"collections-app-prod-api-1\"} | json | msg=\"request\" [$__auto]))",
          "legendFormat": "{{status}}",
          "queryType": "range"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Slowest routes (max)",
      "datasource": {
        "type": "loki",
        "uid": "${DS}"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max_over_time({container=\"collections-app-prod-api-1\"} | json | msg=\"request\" | unwrap duration_ms [$__auto]) by (route)",
          "legendFormat": "{{route}}",
          "queryType": "range"
        }
      ]
    },
    {
      "id": 8,
      "type": "table",
      "title": "API requests",
      "datasource": {
        "type": "loki",
        "uid": "${DS}"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 24,
        "h": 10
      },
      "targets": [
        {
          "refId": "A",
          "queryType": "range",
          "expr": "{container=\"collections-app-prod-api-1\"} | json | msg=\"request\"",
          "maxLines": 500
        }
      ],
      "transformations": [
        {
          "id": "extractFields",
          "options": {
            "source": "Line",
            "format": "json",
            "replace": false,
            "keepTime": true
          }
        },
        {
          "id": "organize",
          "options": {
            "includeByName": {
              "Time": true,
              "method": true,
              "route": true,
              "status": true,
              "duration_ms": true,
              "level": true
            },
            "indexByName": {
              "Time": 0,
              "level": 1,
              "method": 2,
              "route": 3,
              "status": 4,
              "duration_ms": 5
            },
            "renameByName": {
              "duration_ms": "ms"
            }
          }
        },
        {
          "id": "sortBy",
          "options": {
            "sort": [
              {
                "field": "Time",
                "desc": true
              }
            ]
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "filterable": true
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "ms"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "green",
                      "value": null
                    },
                    {
                      "color": "orange",
                      "value": 200
                    },
                    {
                      "color": "red",
                      "value": 1000
                    }
                  ]
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "status"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "green",
                      "value": null
                    },
                    {
                      "color": "orange",
                      "value": 400
                    },
                    {
                      "color": "red",
                      "value": 500
                    }
                  ]
                }
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      }
    },
    {
      "id": 5,
      "type": "logs",
      "title": "API errors and warnings",
      "datasource": {
        "type": "loki",
        "uid": "${DS}"
      },
      "gridPos": {
        "x": 0,
        "y": 26,
        "w": 24,
        "h": 8
      },
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{container=\"collections-app-prod-api-1\"} | json | level=~\"ERROR|WARN\" | line_format \"{{.level}}  {{.msg}}  {{.route}}  {{.status}}  {{.error}}\""
        }
      ]
    },
    {
      "id": 6,
      "type": "logs",
      "title": "Releases, backups, health",
      "datasource": {
        "type": "loki",
        "uid": "${DS}"
      },
      "gridPos": {
        "x": 0,
        "y": 34,
        "w": 24,
        "h": 8
      },
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{unit=~\"collections-.*\"}"
        }
      ]
    },
    {
      "id": 7,
      "type": "logs",
      "title": "Web and database",
      "datasource": {
        "type": "loki",
        "uid": "${DS}"
      },
      "gridPos": {
        "x": 0,
        "y": 42,
        "w": 24,
        "h": 8
      },
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{container=~\"collections-app-prod-(web|db|migrate)-1\"}"
        }
      ]
    }
  ]
}
