{
  "title": "Collections on the Pi",
  "uid": "collections-pi",
  "schemaVersion": 39,
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "DS",
        "type": "datasource",
        "query": "loki",
        "label": "Logs"
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "API latency p95 by route",
      "datasource": {
        "type": "loki",
        "uid": "${DS}"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "quantile_over_time(0.95, {container=\"collections-app-prod-api-1\"} | json | msg=\"request\" | unwrap duration_ms [$__auto]) by (route)",
          "legendFormat": "{{route}}",
          "queryType": "range"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "API latency p50 by route",
      "datasource": {
        "type": "loki",
        "uid": "${DS}"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "quantile_over_time(0.5, {container=\"collections-app-prod-api-1\"} | json | msg=\"request\" | unwrap duration_ms [$__auto]) by (route)",
          "legendFormat": "{{route}}",
          "queryType": "range"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Requests by status",
      "datasource": {
        "type": "loki",
        "uid": "${DS}"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (status) (count_over_time({container=\"collections-app-prod-api-1\"} | json | msg=\"request\" [$__auto]))",
          "legendFormat": "{{status}}",
          "queryType": "range"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Slowest routes (max)",
      "datasource": {
        "type": "loki",
        "uid": "${DS}"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max_over_time({container=\"collections-app-prod-api-1\"} | json | msg=\"request\" | unwrap duration_ms [$__auto]) by (route)",
          "legendFormat": "{{route}}",
          "queryType": "range"
        }
      ]
    },
    {
      "id": 5,
      "type": "logs",
      "title": "API errors and warnings",
      "datasource": {
        "type": "loki",
        "uid": "${DS}"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 24,
        "h": 8
      },
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{container=\"collections-app-prod-api-1\"} | json | level=~\"ERROR|WARN\""
        }
      ]
    },
    {
      "id": 6,
      "type": "logs",
      "title": "Releases, backups, health",
      "datasource": {
        "type": "loki",
        "uid": "${DS}"
      },
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 24,
        "h": 8
      },
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{unit=~\"collections-.*\"}"
        }
      ]
    },
    {
      "id": 7,
      "type": "logs",
      "title": "Web and database",
      "datasource": {
        "type": "loki",
        "uid": "${DS}"
      },
      "gridPos": {
        "x": 0,
        "y": 32,
        "w": 24,
        "h": 8
      },
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{container=~\"collections-app-prod-(web|db|migrate)-1\"}"
        }
      ]
    }
  ]
}
