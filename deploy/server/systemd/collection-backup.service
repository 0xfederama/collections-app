# Nightly backup + prune of the prod stack. Install: see deploy/README.md "Backups" (systemd timer).
# Edit User and the paths if your clone isn't /home/fede/collections-app.
[Unit]
Description=Collections App backup (Postgres + images) and prune
Wants=network-online.target docker.service
After=network-online.target docker.service

[Service]
Type=oneshot
User=fede
WorkingDirectory=/home/fede/collections-app
# Shares release.sh's lock, so a backup and a deploy never run at the same time.
ExecStart=/usr/bin/flock /home/fede/collections-app/deploy/server/.release-state/lock /home/fede/collections-app/deploy/prod backup
ExecStartPost=/home/fede/collections-app/deploy/prod prune
