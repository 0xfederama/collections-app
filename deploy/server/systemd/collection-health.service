# Pi health ping to healthchecks.io (roadmap #24). Install: see deploy/README.md "Alerts".
[Unit]
Description=Collections App health ping
Wants=network-online.target docker.service
After=network-online.target docker.service

[Service]
Type=oneshot
User=fede
WorkingDirectory=/home/fede/collections-app
ExecStart=/home/fede/collections-app/deploy/server/health.sh
